# 统一行尾，避免 Windows / Linux / macOS 各自 checkout 后产生整文件 diff
* text=auto eol=lf

# gradlew 是 POSIX shell 脚本。若在 Windows 上 checkout 时被转成 CRLF，
# Linux / macOS / CI 执行会直接报 `bad interpreter: /bin/sh^M`。
gradlew     text eol=lf
gradlew.bat text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制，禁止任何换行转换与文本 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.so   binary
*.jar  binary
*.apk  binary
*.a    binary
*.zip  binary

# Kotlin / Gradle 源码在所有平台都按 LF 存储
*.kt      text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.pro     text eol=lf
